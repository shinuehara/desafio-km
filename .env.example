# Banco Postgres (no Supabase: botão "Connect" > "Transaction pooler", porta 6543)
DATABASE_URL=postgres://postgres:senha@localhost:5432/desafiokm
# Opcional: conexão para criar/atualizar tabelas (no Supabase: "Session pooler", porta 5432).
# Se ficar vazia, usa DATABASE_URL.
DATABASE_URL_DIRECT=

# Senha do painel do organizador (/admin)
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório e longo, usado para assinar o login do painel
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-longo

# Endereço público do site, sem barra no final (usado nos links enviados pelo WhatsApp)
APP_URL=http://localhost:3000

# Arquivos (fotos, regulamento, foto do kit).
# Sem estas variáveis, os arquivos ficam na pasta .data/ (só serve para desenvolvimento).
# No Supabase: Project Settings > API (Project URL e a chave secreta "service_role").
# As pastas "publico" e "fotos" são criadas sozinhas pelo "npm run setup".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha da limpeza diária de fotos antigas (texto aleatório longo).
# Use o mesmo valor no segredo CRON_SECRET do GitHub Actions.
CRON_SECRET=
